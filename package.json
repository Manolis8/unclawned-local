{
  "name": "unclawned",
  "version": "1.0.0",
  "description": "Local AI browser agent — runs on your machine, controlled via Chrome extension",
  "type": "module",
  "bin": {
    "jarvis": "./bin/jarvis.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const{cpSync}=require('fs');cpSync('src/data','dist/data',{recursive:true})\"",
    "start": "node bin/jarvis.js",
    "dev": "tsx --import ./src/cli-preload.ts src/cli.ts",
    "cli": "tsx --import ./src/cli-preload.ts src/cli.ts",
    "server": "tsx --import ./src/cli-preload.ts src/index.ts"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.7.0"
  },
  "dependencies": {
    "@ai-sdk/xai": "^3.0.89",
    "@anthropic-ai/sdk": "^0.95.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/crypto-js": "^4.2.2",
    "@types/picomatch": "^4.0.3",
    "ai": "^6.0.177",
    "croner": "^10.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "openai": "^6.29.0",
    "picomatch": "^4.0.4",
    "playwright": "^1.58.2",
    "playwright-core": "^1.52.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
